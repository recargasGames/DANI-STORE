<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta
        name="description"
        content="Inicia sesión en tu cuenta de ElectroHogar."
    >

    <title>Iniciar sesión | ElectroHogar</title>

    <link rel="stylesheet" href="css/styles.css">
</head>

<body>

    <!-- ==============================
         HEADER
    =============================== -->
    <header class="header">
        <div class="container header-content">

            <a href="index.html" class="logo">
                <span class="logo-icon">EH</span>

                <span class="logo-text">
                    ElectroHogar
                </span>
            </a>

            <nav class="menu" id="mainMenu">
                <a href="index.html">Inicio</a>
                <a href="index.html#productos">Productos</a>
                <a href="index.html#categorias">Categorías</a>
                <a href="index.html#como-funciona">Cómo funciona</a>
            </nav>

            <div class="nav-actions">
                <a href="login.html" class="btn btn-outline">
                    Iniciar sesión
                </a>

                <a href="registro.html" class="btn btn-primary">
                    Crear cuenta
                </a>
            </div>

            <button
                class="menu-toggle"
                id="menuToggle"
                type="button"
                aria-label="Abrir menú"
                aria-expanded="false"
            >
                ☰
            </button>

        </div>
    </header>


    <!-- ==============================
         LOGIN
    =============================== -->
    <main>

        <section class="auth-section">

            <div class="container">

                <div class="auth-container">

                    <div class="auth-card">

                        <!-- Encabezado -->

                        <div class="auth-header">

                            <div class="auth-icon">
                                EH
                            </div>

                            <h1>
                                Bienvenido de nuevo
                            </h1>

                            <p>
                                Ingresa a tu cuenta para consultar
                                tus compras y créditos.
                            </p>

                        </div>


                        <!-- Formulario -->

                        <form id="loginForm">

                            <div class="form-group">

                                <label
                                    for="email"
                                    class="form-label"
                                >
                                    Correo electrónico
                                </label>

                                <input
                                    type="email"
                                    id="email"
                                    name="email"
                                    class="form-control"
                                    placeholder="tucorreo@ejemplo.com"
                                    autocomplete="email"
                                    required
                                >

                            </div>


                            <div class="form-group">

                                <label
                                    for="password"
                                    class="form-label"
                                >
                                    Contraseña
                                </label>

                                <div class="password-wrapper">

                                    <input
                                        type="password"
                                        id="password"
                                        name="password"
                                        class="form-control"
                                        placeholder="Ingresa tu contraseña"
                                        autocomplete="current-password"
                                        required
                                    >

                                    <button
                                        type="button"
                                        id="togglePassword"
                                        class="password-toggle"
                                        aria-label="Mostrar contraseña"
                                    >
                                        👁
                                    </button>

                                </div>

                            </div>


                            <div class="form-options">

                                <label class="checkbox-label">

                                    <input
                                        type="checkbox"
                                        id="remember"
                                    >

                                    <span>
                                        Recordarme
                                    </span>

                                </label>

                                <a href="#" id="forgotPassword">
                                    ¿Olvidaste tu contraseña?
                                </a>

                            </div>


                            <div
                                id="loginMessage"
                                class="form-message"
                                style="display: none;"
                            ></div>


                            <button
                                type="submit"
                                class="btn btn-primary btn-full"
                            >
                                Iniciar sesión
                            </button>

                        </form>


                        <!-- Registro -->

                        <div class="auth-divider">
                            <span>o</span>
                        </div>

                        <div class="auth-register">

                            <p>
                                ¿Todavía no tienes una cuenta?
                            </p>

                            <a
                                href="registro.html"
                                class="btn btn-outline btn-full"
                            >
                                Crear una cuenta
                            </a>

                        </div>


                        <!-- Volver -->

                        <div class="auth-back">

                            <a href="index.html">
                                ← Volver a la tienda
                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </section>

    </main>


    <!-- ==============================
         FOOTER
    =============================== -->
    <footer class="footer">

        <div class="container">

            <div class="footer-bottom">
                © 2026 ElectroHogar. Todos los derechos reservados.
            </div>

        </div>

    </footer>


    <!-- ==============================
         SCRIPTS
    =============================== -->

    <script src="js/app.js"></script>


    <script>

        // ==========================================
        // MOSTRAR / OCULTAR CONTRASEÑA
        // ==========================================

        const passwordInput =
            document.getElementById("password");

        const togglePassword =
            document.getElementById("togglePassword");


        togglePassword.addEventListener("click", () => {

            const tipo =
                passwordInput.type === "password"
                    ? "text"
                    : "password";

            passwordInput.type = tipo;

            togglePassword.textContent =
                tipo === "password"
                    ? "👁"
                    : "🙈";

        });


        // ==========================================
        // FORMULARIO DE LOGIN
        // ==========================================

        const loginForm =
            document.getElementById("loginForm");

        const loginMessage =
            document.getElementById("loginMessage");


        loginForm.addEventListener("submit", (evento) => {

            evento.preventDefault();

            const email =
                document.getElementById("email").value.trim();

            const password =
                document.getElementById("password").value;


            if (!email || !password) {

                mostrarMensajeLogin(
                    "Completa todos los campos."
                );

                return;
            }


            /*
             * ==========================================
             * NOTA:
             *
             * Aquí conectaremos Firebase Authentication.
             *
             * No vamos a guardar contraseñas manualmente
             * en localStorage ni en Firestore.
             * ==========================================
             */

            mostrarMensajeLogin(
                "El sistema de acceso se conectará con Firebase en el siguiente paso.",
                "info"
            );

        });


        // ==========================================
        // RECUPERAR CONTRASEÑA
        // ==========================================

        document
            .getElementById("forgotPassword")
            .addEventListener("click", (evento) => {

                evento.preventDefault();

                const email =
                    document.getElementById("email").value.trim();


                if (!email) {

                    mostrarMensajeLogin(
                        "Escribe primero tu correo electrónico."
                    );

                    document
                        .getElementById("email")
                        .focus();

                    return;
                }


                mostrarMensajeLogin(
                    "La recuperación de contraseña se conectará con Firebase."
                );

            });


        // ==========================================
        // MENSAJES
        // ==========================================

        function mostrarMensajeLogin(
            mensaje,
            tipo = "error"
        ) {

            loginMessage.textContent = mensaje;

            loginMessage.style.display = "block";

            loginMessage.className =
                `form-message ${tipo}`;

        }

    </script>

</body>
</html>
